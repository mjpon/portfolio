{
  // Cloudflare Workers with static assets. The name must match the Worker in the dashboard.
  "name": "portfolio",
  // Set this to today's date when you create or move the project
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./site",
    // Unknown addresses get site/404.html with a 404 status
    "not_found_handling": "404-page"
  }
}
